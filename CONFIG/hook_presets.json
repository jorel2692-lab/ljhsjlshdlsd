    "matrix": {"label": "Matrix Code Rain", "asset": "backgrounds/matrix.mp4", "type": "video", "tag": "cyber"},
    "void": {"label": "Void Espace Noir", "asset": "backgrounds/void.mp4", "type": "video", "tag": "minimal"},
    "underwater": {"label": "Underwater Ocean", "asset": "backgrounds/underwater.mp4", "type": "video", "tag": "nature"},
    "volcanic": {"label": "Volcanic Lave", "asset": "backgrounds/volcanic.mp4", "type": "video", "tag": "danger"},
    "space": {"label": "Space Galaxie", "asset": "backgrounds/space.mp4", "type": "video", "tag": "cosmic"},
    "retro_8bit": {"label": "Retro 8-bit", "asset": "backgrounds/retro_8bit.mp4", "type": "video", "tag": "gaming"},
